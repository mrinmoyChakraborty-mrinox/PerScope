{
  "manifest_version": 3,
  "name": "PerScope Privacy Redactor",
  "version": "1.0.1",
  "description": "Local GPU-accelerated PII detection and image redaction. Uses dedicated GPU (NVIDIA RTX 4050) with integrated/CPU fallback.",
  "permissions": ["offscreen", "storage", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "PerScope Privacy Redactor"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "dashboard.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "models/*",
        "models/*/*",
        "models/*/*/*",
        "models/**/*",
        "ort/*",
        "ort/*/*",
        "assets/*",
        "dashboard.html"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "icons": {
    "128": "assets/icon128.png"
  }
}
